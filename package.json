{
  "name": "purrcat-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "PurrCat desktop shell (Electron) — local-first AI Agent",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/sync-vendor.mjs",
    "sync:vendor": "node scripts/sync-vendor.mjs",
    "predev": "node scripts/sync-vendor.mjs && npm run build:ui",
    "dev": "node scripts/dev.mjs",
    "predev:split": "node scripts/sync-vendor.mjs",
    "dev:split": "node scripts/dev.mjs",
    "electron:dev": "cross-env ELECTRON_DEV=1 electron .",
    "installer:dev": "electron installer",
    "typecheck": "tsc --noEmit",
    "build:ui": "esbuild ui/web-minimal/src/host/main.ts --bundle --format=iife --target=chrome120 --outfile=ui/web-minimal/assets/host.js --sourcemap",
    "watch:ui": "esbuild ui/web-minimal/src/host/main.ts --bundle --format=iife --target=chrome120 --outfile=ui/web-minimal/assets/host.js --sourcemap --watch",
    "dist": "electron-builder --win",
    "lint": "echo no-root-lint"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "^11.11.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "katex": "^0.16.11",
    "marked": "^12.0.2",
    "typescript": "^5.7.3",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=18 <24"
  },
  "build": {
    "appId": "com.purrpod.purrcat",
    "productName": "PurrCat",
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/main",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "electron/app.ico",
      "artifactName": "PurrCat-Setup-${version}.exe",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "electron/icon.png",
      "artifactName": "PurrCat-${version}-${arch}.dmg",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "linux": {
      "icon": "electron/icon.png",
      "artifactName": "PurrCat-${version}-${arch}.tar.gz",
      "category": "Utility",
      "target": [
        "tar.gz"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "PurrPod",
      "repo": "purrcat"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/app.ico",
      "uninstallerIcon": "electron/app.ico",
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
