{
  "id": "builtin-background",
  "name": "背景",
  "icon": "▦",
  "slot": { "type": "fixed", "area": "background" },
  "entry": "index.html",
  "configSchema": [
    { "key": "mode", "label": "背景模式", "type": "select", "options": ["none", "wallpaper"], "default": "none" },
    { "key": "wallpapers", "label": "壁纸列表", "type": "wallpapers", "default": [] },
    { "key": "opacity", "label": "壁纸透明度", "type": "range", "min": 0.2, "max": 1, "step": 0.05, "default": 1 },
    { "key": "intervalSec", "label": "轮播间隔（秒，0 不轮播）", "type": "number", "default": 0 }
  ]
}