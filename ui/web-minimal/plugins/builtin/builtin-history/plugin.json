{
  "id": "builtin-history",
  "root": "builtin",
  "name": "会话历史",
  "icon": "history",
  "slot": { "area": "session" },
  "entry": "index.html",
  "requires": [
    { "name": "marked", "range": "^12" },
    { "name": "katex", "range": "^0.16" },
    { "name": "highlight", "range": "^11" }
  ],
  "configSchema": [
    { "key": "opacity", "label": "面板透明度", "type": "range", "min": 0.15, "max": 1, "step": 0.05, "default": 1 },
    { "key": "show_tool_calls", "label": "工具调用展示", "type": "switch", "default": true },
    { "key": "show_reasoning", "label": "思考内容展示", "type": "switch", "default": true },
    { "key": "show_workflow_hint", "label": "workflow hint 展示", "type": "switch", "default": false }
  ]
}